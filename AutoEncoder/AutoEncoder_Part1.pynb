    {
      "cell_type": "code",
      "source": [
        "%%writefile src/net.py\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from collections import namedtuple\n",
        "\n",
        "Output = namedtuple(\"Output\", [\"embedding\", \"reconstructed\", \"loss\"])\n",
        "\n",
        "class AutoEncoder(nn.Module):\n",
        "    def __init__(self, img_size: int=28, latent_dim: int=2):\n",
        "        super().__init__()\n",
        "        self.img_size = img_size\n",
        "        self.latent_dim = latent_dim\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(img_size*img_size, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(32, latent_dim)\n",
        "        )\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(latent_dim, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(32, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(64, img_size*img_size),\n",
        "            nn.Sigmoid()\n",
        "        )\n",
        "\n",
        "    def forward_enc(self, x):\n",
        "        # x: batch_size, channel, height, width\n",
        "        x = x.flatten(1) # batch_size, channel*height*width\n",
        "        return self.encoder(x)\n",
        "\n",
        "    def forward_dec(self, z):\n",
        "        # z: batch_size, latent_dim\n",
        "        return self.decoder(z)\n",
        "\n",
        "    @torch.no_grad()\n",
        "    def reconstruct(self, z, shape):\n",
        "        xprime = self.decoder(z)\n",
        "        xprime = xprime.reshape(shape)\n",
        "        return xprime\n",
        "\n",
        "    def forward(self, x):\n",
        "        # z: batch_size, latent_dim\n",
        "        z = self.forward_enc(x)\n",
        "        xprime = self.forward_dec(z)\n",
        "        xprime = xprime.reshape(x.shape)\n",
        "\n",
        "        error_sq = (x - xprime)**2\n",
        "        loss = error_sq.mean(dim=0).sum()\n",
        "        return Output(embedding=z, reconstructed=xprime, loss=loss)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    model = AutoEncoder()\n",
        "    rand = torch.rand(4, 1, 28, 28)\n",
        "    output = model(rand)\n",
        "    print(output.embedding.shape)\n",
        "    print(output.reconstructed.shape)\n",
        "    print(output.loss)\n"
      ],
      "metadata": {
        "id": "639hL0RWzj9h"
      },
      "execution_count": null,
      "outputs": []
    },
