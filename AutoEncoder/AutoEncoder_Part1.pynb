    {
      "cell_type": "markdown",
      "source": [
        "# Data"
      ],
      "metadata": {
        "id": "Tb4VmZQs2vjv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "%%writefile src/data.py\n",
        "import lightning as L\n",
        "import torchvision.transforms as transforms\n",
        "from torchvision.datasets import MNIST\n",
        "from torch.utils.data import DataLoader\n",
        "\n",
        "\n",
        "class MNISTDATAModule(L.LightningDataModule):\n",
        "    def __init__(self, batch_size: int=64, data_dir: str=\"./data\", img_size: int=28):\n",
        "        super().__init__()\n",
        "        self.save_hyperparameters()\n",
        "\n",
        "        tensor_transform = transforms.Compose([\n",
        "            transforms.Resize((img_size, img_size)),\n",
        "            transforms.ToTensor(),\n",
        "        ])\n",
        "\n",
        "        self.train_set = MNIST(data_dir, train=True, download=True, transform=tensor_transform)\n",
        "        self.valid_set = MNIST(data_dir, train=False, download=True, transform=tensor_transform)\n",
        "\n",
        "    def train_dataloader(self):\n",
        "        return DataLoader(self.train_set, batch_size=self.hparams.batch_size, shuffle=True)\n",
        "\n",
        "    def val_dataloader(self):\n",
        "        return DataLoader(self.valid_set, batch_size=self.hparams.batch_size, shuffle=False)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    dm = MNISTDATAModule()\n",
        "    images, labels = next(iter(dm.train_dataloader()))\n",
        "    print(images.shape, labels.shape)"
      ],
      "metadata": {
        "id": "rxF6TQCj3wiU"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "!python src/data.py"
      ],
      "metadata": {
        "id": "cbXZEAru5eUk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Training"
      ],
      "metadata": {
        "id": "gFduj7W55goc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "%%writefile train.py\n",
        "import os\n",
        "import torch\n",
        "from torchvision.utils import save_image\n",
        "import lightning as L\n",
        "from lightning.pytorch import seed_everything\n",
        "from lightning.pytorch.callbacks import TQDMProgressBar\n",
        "import hydra\n",
        "from omegaconf import DictConfig\n",
        "from src.net import AutoEncoder\n",
        "from src.data import MNISTDATAModule\n",
        "from torchmetrics import MeanMetric\n",
        "from safetensors.torch import save_model\n",
        "\n",
        "\n",
        "class ModelModule(L.LightningModule):\n",
        "    def __init__(self, net, learning_rate: float=5e-4):\n",
        "        super().__init__()\n",
        "        self.save_hyperparameters(ignore=[\"net\"])\n",
        "        self.net = net\n",
        "        self.val_loss = MeanMetric()\n",
        "\n",
        "    def on_train_start(self):\n",
        "        self.val_loss.reset()\n",
        "\n",
        "    def training_step(self, batch, batch_idx):\n",
        "        images, labels = batch\n",
        "        bs = images.shape[0]\n",
        "        output = self.net(images)\n",
        "        self.log(\"train_loss\", output.loss, prog_bar=True, on_step=True, on_epoch=False, batch_size=bs)\n",
        "        return output.loss\n",
        "\n",
        "    def validation_step(self, batch, batch_idx):\n",
        "        images, labels = batch\n",
        "        bs = images.shape[0]\n",
        "        output = self.net(images)\n",
        "        self.val_loss(output.loss)\n",
        "\n",
        "    def on_validation_epoch_end(self):\n",
        "        if self.trainer.sanity_checking:\n",
        "            return\n",
        "        data = next(iter(self.trainer.val_dataloaders.dataset))\n",
        "        images = data[0].unsqueeze(0) # create batch dimension\n",
        "        z = self.net.forward_enc(images)\n",
        "        reconstructed = self.net.reconstruct(z, images.shape)\n",
        "        dir_path = \"gen_sampels\"\n",
        "        os.makedirs(dir_path, exist_ok=True)\n",
        "        file_path = os.path.join(dir_path, f\"gen_iter_{self.trainer.fit_loop.epoch_loop.total_batch_idx}.png\")\n",
        "        save_image(reconstructed, file_path)\n",
        "\n",
        "        self.log(\"valid_loss\", self.val_loss.compute(), prog_bar=True, on_step=False, on_epoch=True)\n",
        "\n",
        "    def configure_optimizers(self):\n",
        "        return torch.optim.Adam(self.net.parameters(), lr=self.hparams.learning_rate)\n",
        "\n",
        "@hydra.main(version_base=\"1.3\", config_path=\"configs\", config_name=\"config\")\n",
        "def main(cfg: DictConfig) -> None:\n",
        "    seed_everything(cfg.seed, workers=True)\n",
        "    dm = MNISTDATAModule(**cfg.data, img_size=cfg.net.img_size)\n",
        "    net = AutoEncoder(**cfg.net)\n",
        "    model = ModelModule(net, **cfg.model)\n",
        "    trainer = L.Trainer(\n",
        "        check_val_every_n_epoch=None,\n",
        "        callbacks=[TQDMProgressBar(refresh_rate=50)],\n",
        "        **cfg.trainer\n",
        "    )\n",
        "    trainer.fit(model, dm)\n",
        "    save_model(net, \"model.safetensors\")\n",
        "\n",
        "if __name__==\"__main__\":\n",
        "    main()"
      ],
      "metadata": {
        "id": "LbhrLNc55wiy"
      },
      "execution_count": null,
      "outputs": []
    },
